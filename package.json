{
  "name": "@lazorkit/portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": "24.x",
    "pnpm": "10.26.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:checked": "eslint src/security src/chain src/approval src/typed src/hooks/use-recipient-check.ts src/pages src/components/*.tsx src/config.ts src/main.tsx api test e2e scripts/record-chain-fixtures.ts",
    "test": "node --test 'test/*.test.ts'",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "headers": "node scripts/gen-headers.mjs",
    "headers:check": "node scripts/gen-headers.mjs --check",
    "e2e": "node e2e/run.mjs",
    "e2e:typed": "node e2e/typed.mjs",
    "preview": "vite preview"
  },
